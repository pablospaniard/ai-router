{
  "name": "airo-cli",
  "version": "0.7.0",
  "description": "Adaptive Intelligence Routing & Orchestration for Claude Code and Codex CLI",
  "keywords": [
    "ai",
    "cli",
    "claude-code",
    "codex",
    "orchestration",
    "router"
  ],
  "homepage": "https://github.com/pablospaniard/airo-cli#readme",
  "bugs": {
    "url": "https://github.com/pablospaniard/airo-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablospaniard/airo-cli.git"
  },
  "type": "module",
  "files": [
    "dist/*.js",
    "README.md",
    "airo.config.example.json"
  ],
  "bin": {
    "airo": "dist/cli.js",
    "ai-router": "dist/cli.js",
    "airoute": "dist/cli.js",
    "ai-route": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "npm run test:coverage",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-exclude=dist/test/** --test-coverage-lines=95 --test-coverage-functions=95 dist/test/*.test.js",
    "start": "node dist/cli.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
